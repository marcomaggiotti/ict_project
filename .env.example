# Top-level docker-compose.yml environment. Copy to .env and fill in secrets.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Shared across services' /agent/chat endpoints.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Per-service API keys for the X-API-Key header. Leave empty for local dev (auth disabled).
# Always set MASTER_API_KEY outside local dev - that service can stop/start containers.
AUDIO_API_KEY=
CALENDAR_API_KEY=
IMAGE_API_KEY=
MASTER_API_KEY=

CORS_ALLOW_ORIGINS=*
