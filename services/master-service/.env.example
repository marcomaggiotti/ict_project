SERVICE_NAME=master-service
# Strongly recommended: this service can stop/start containers, always set an API key
# outside of local dev.
API_KEY=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

CORS_ALLOW_ORIGINS=*

# Optional: override the built-in service registry, e.g.
# MANAGED_SERVICES_JSON=[{"name":"audio-service","container_name":"ai-agent-audio-service","base_url":"http://audio-service:8000"}]
MANAGED_SERVICES_JSON=
