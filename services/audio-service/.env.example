SERVICE_NAME=audio-service
API_KEY=

# sqlite | postgres | cosmos
DB_BACKEND=sqlite
SQLITE_PATH=./audio_service.db

# Postgres - works for local docker-compose Postgres or Render managed Postgres.
# Render connection string: postgresql://<user>:<password>@<host>/<database>
POSTGRES_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/audio_db

# Azure Cosmos DB (NoSQL API)
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=ai-agent
COSMOS_CONTAINER=audio_files

MAX_UPLOAD_MB=25

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

CORS_ALLOW_ORIGINS=*
