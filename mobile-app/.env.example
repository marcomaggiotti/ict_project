# Build-time defaults (inlined by Expo, EXPO_PUBLIC_* prefix required). These only set the
# initial value - the in-app Settings screen lets a user override them at runtime, persisted
# on-device, since a mobile binary can't receive env vars injected at "container start" the
# way the webapp's Docker image does.
EXPO_PUBLIC_AUDIO_URL=http://localhost:8001
EXPO_PUBLIC_CALENDAR_URL=http://localhost:8003
EXPO_PUBLIC_IMAGE_URL=http://localhost:8002
EXPO_PUBLIC_MASTER_URL=http://localhost:8000
