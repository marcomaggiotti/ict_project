# Used only by `npm run dev` (Vite dev server). The Docker build instead reads
# AUDIO_URL/CALENDAR_URL/IMAGE_URL/MASTER_URL at container start - see docker-entrypoint.sh.
VITE_AUDIO_URL=http://localhost:8001
VITE_CALENDAR_URL=http://localhost:8003
VITE_IMAGE_URL=http://localhost:8002
VITE_MASTER_URL=http://localhost:8000
